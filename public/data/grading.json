  "rank_mapping": {
    "official_description": "A-至C-在各等级对应区间内，按照同等级中的总评成绩数值排序赋值。",
    "parameters": {
      "L": "该等级绩点区间最小值",
      "U": "该等级绩点区间最大值",
      "N": "该等级内不重复总评成绩数值的个数，不是该等级学生人数",
      "r": "该等级内不重复总评成绩数值从高到低的位次，最高分为1；同分同位次"
    },
    "branches": [
      {
        "condition": "N == 1",
        "formula": "(L + U) / 2"
      },
      {
        "condition": "2 <= N && N < 5",
        "formula": "U - (U - L) * r / (N + 1)"
      },
      {
        "condition": "N >= 5",
        "formula": "U - (U - L) * (r - 1) / (N - 1)"
      }
    ],
    "valid_input_constraints": [
      "N是正整数",
      "r是1至N的整数",
      "先按课程规则确定等级，再在该等级内映射绩点",
      "P/NP记录不参与班级总评成绩排序"
    ],
    "is_global_percentage_score_linear_mapping": false,
    "universal_percentage_score_to_grade_thresholds_verified": false,
    "missing_distribution_behavior": "只有等级、缺乏该等级内总评成绩分布时，输出该等级绩点区间及相应GPA区间；不要伪造精确绩点。",
    "source_ids": [
      "fisf_handbook",
      "wangdao_handbook_2024"
    ]
  },
  "gpa": {
    "formula": "sum(c_i * g_i for i in I) / sum(c_i for i in I)",
    "parameters": {
      "c_i": "第i条计入记录的学分",
      "g_i": "第i条计入记录的绩点",
      "I": "所选计算口径中计入GPA的记录集合"
    },
    "denominator_must_exclude_non_gpa_records": true,
    "known_exclusions": [
      "P",
      "NP",
      "成绩前带*的外校转入成绩",
      "社会实践及有专门规定不计GPA的课程"
    ],
    "precision": {
      "calculation_decimal_places": 3,
      "transcript_display_decimal_places": 2,
      "rounding_method": null,
      "rounding_method_verified": false,
      "per_course_grade_point_rounding_method": null,
      "note": "官方公开条文明确保留位数，但本次未查明四舍五入、截断、银行家舍入等具体算法，也未查明单课映射绩点的舍入方式。代码不可把其中一种标为已核实官方规则。"
    },
    "degree_audit_scope": "按毕业时所在专业教学培养方案规定的课程有效成绩计算，不能默认等于全部曾选课程。",
    "source_ids": [
      "fisf_handbook",
      "wangdao_handbook_2024",
      "fao_undergraduate_cn"
    ]
  },
  "scenario_calculator": {
    "status": "数学情景计算，不预测实际成绩概率",
    "parameters": {
      "C": "当前所选口径计入GPA的总学分",
      "G": "对应当前GPA",
      "c": "拟加入课程的学分",
      "g": "拟加入课程的情景绩点"
    },
    "add_course_formula": "(C * G + c * g) / (C + c)",
    "delta_formula": "c * (g - G) / (C + c)",
    "interval_formula": {
      "lower": "(C * G + c * grade_min) / (C + c)",
      "upper": "(C * G + c * grade_max) / (C + c)"
    },
    "pnp_effect": "该条课程成绩以P或NP记载时，不加入GPA分子和分母；是否获得学分、满足培养方案应另行检查。",
    "no_probability_from_excellent_rate": true,
    "no_probability_from_survey_chart": true,
    "probability_warning": "优秀率总则不是个人获A概率。调查图、匿名经历和用户自填概率仅可作为有标识的情景假设，不能作为真实成绩概率或官方结论。"
  },
