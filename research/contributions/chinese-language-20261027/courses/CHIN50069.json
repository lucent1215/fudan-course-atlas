        "prerequisites": [],
        "assessment": [
          {
            "criteria": "出勤Attendance",
            "percentage": 10.0,
            "standard": "要求学生准时出席每一次面授，遵守基本课堂秩序，事假病假需向任课老师报备请批，全学期请假应不得超过三次"
          },
          {
            "criteria": "课题研讨Topic Discussion",
            "percentage": 20.0,
            "standard": "积极响应老师提问，主动参与课堂讨论，阅读教师下发的文献，为课程做好复习与预习工作，并在此过程中有意识训练批判性思辨及学术表达的能力。就每次课程布置的阅读文献，于课前或课后提交书面的短篇论述和问题，本部分可据其具体完成情况在总评分基础上获取1-10分的绝对附加分值。"
          },
          {
            "criteria": "汇报Presentation",
            "percentage": 20.0,
            "standard": "学生就诠释学相关的基本概念/发展历史/文本分析的经典案例细读作一次学术发言，要求准备充分，发言有条理、有基本的问题意识与结论倾向，能够较好地表达一个与诠释学相关的观点，并回答听众同学的提问。"
          },
          {
            "criteria": "期末考试Final Examination：论文 ",
            "percentage": 50.0,
            "standard": "围绕本课程之题旨，选取文学或理论议题的一个具体案例，以诠释学相关理论资源为主导方向但不限于狭义的诠释学理论，学术思辨与文本分析相结合，撰写学术论文，要求论述焦点集中，语言清晰晓畅，观点明确，论证有层次，有基本的学术史研判和学术问题探讨意识，体现一定程度的批判思维与独立思考能力。"
          }
        ],
        "grade_rule": "等级制",
